{
    "name": "starterkit/framework",
    "description": "Reusable framework foundation for the Laravel Engineering Starter Kit.",
    "version": "1.0.0",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "illuminate/console": "^13.0",
        "illuminate/contracts": "^13.0",
        "illuminate/support": "^13.0"
    },
    "autoload": {
        "psr-4": {
            "StarterKit\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "StarterKit\\StarterKitServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
